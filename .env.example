# ─────────────────────────────────────────────────────────────────────────────
# Saffron Yard — environment variables
# Locally everything has a working default (a SQLite file in ./data).
# On Vercel set the REQUIRED ones below for Production AND Preview.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED on Vercel — your Turso database.
#   turso db show <db> --url          → libsql://<db>-<org>.turso.io
#   turso db tokens create <db>       → token (must be read-write)
# The names TURSO_DATABASE_URL / TURSO_AUTH_TOKEN (created by Vercel's Turso
# integration) are accepted too.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# RECOMMENDED — signs guest order-access cookies and payment callbacks.
# Generate with:  openssl rand -base64 32   (at least 32 characters)
# If unset, a random secret is generated once and stored in the database.
AUTH_SECRET=

# RECOMMENDED — first admin account, created on the first request when the
# database has no admin yet. Changing these later does NOT change an existing
# admin; use Admin → My Account for that.
ADMIN_EMAIL=admin@saffronyard.kw
ADMIN_PASSWORD=

# RECOMMENDED — public URL (payment return links, social previews).
# Defaults to the Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# OPTIONAL — online payment provider ("simulator" = built-in test gateway).
PAYMENT_PROVIDER=simulator

# OPTIONAL — set to 0 to stop copying the stock menu photos into the database.
LOCALIZE_IMAGES=1
