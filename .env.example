# ─────────────────────────────────────────────────────────────────────────────
# Saffron Yard — environment variables
# Everything has a working default, so the app runs with no .env at all.
# Copy to .env.local and fill in for production.
# ─────────────────────────────────────────────────────────────────────────────

# Database. Defaults to a local SQLite file (created automatically).
# In production point this at a hosted libSQL/Turso database, e.g.
#   DATABASE_URL=libsql://saffron-yard-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./data/saffron-yard.db
DATABASE_AUTH_TOKEN=

# Secret used to sign guest order-access cookies and payment callbacks.
# Generate with:  openssl rand -base64 32
# If unset, a random secret is generated once and stored in the database.
AUTH_SECRET=

# First admin account, created on first start if no admin exists yet.
# CHANGE THE PASSWORD after first login (Admin → Account).
ADMIN_EMAIL=admin@saffronyard.kw
ADMIN_PASSWORD=ChangeMe-Saffron-2026

# Online payment provider. "simulator" is a built-in test gateway (no card
# data is ever collected). Real Kuwait gateways (KNET via MyFatoorah, Tap,
# UPayments, …) plug in under src/lib/payments/providers/.
PAYMENT_PROVIDER=simulator

# Public URL of the site (used for payment return URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
